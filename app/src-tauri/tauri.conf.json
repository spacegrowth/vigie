{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vigie",
  "mainBinaryName": "Vigie",
  "version": "0.1.6",
  "identifier": "dev.vigie.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vigie",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "tray-popover",
        "url": "index.html#/tray",
        "title": "Vigie",
        "width": 400,
        "height": 560,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3MzEwNjczRDNDMTI4NjQKUldSa0tNSFRjd1l4aHdVK243WVpRK0tIZGxzMUNGWEdjTzdaU3gwdmdseUJmV3oySVNHdUw4TjAK",
      "endpoints": [
        "https://spacegrowth.github.io/vigie/latest.json"
      ]
    }
  }
}
